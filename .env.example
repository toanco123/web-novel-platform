# Copy file này thành .env rồi sửa giá trị (.env không được commit)

# Dev server: đổi cổng/host tùy ý, vd PORT=4000
HOST=localhost
PORT=3000

# Supabase: lấy từ Supabase Dashboard > Project Settings > API.
# Bỏ trống thì web chạy bằng dữ liệu giả trong localStorage (api.mock.ts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true: dùng dữ liệu giả dù đã điền Supabase ở trên (làm UI offline). Test tự động luôn bật
VITE_USE_MOCK=

# Nút đăng nhập mạng xã hội đã bật trên Supabase (cần Client ID/Secret), vd: google,facebook
VITE_AUTH_PROVIDERS=

# Captcha Cloudflare Turnstile cho đăng nhập/đăng ký/quên mật khẩu (Site Key của widget). Bỏ trống thì
# không có captcha. Khai báo ở đây và trên Vercel TRƯỚC, deploy xong mới bật Captcha ở Supabase
# Dashboard (Authentication > Attack Protection, dán Secret Key), nếu không form sẽ bị Supabase từ chối.
VITE_TURNSTILE_SITE_KEY=

# Địa chỉ web dùng cho canonical, sitemap và ảnh xem trước khi chia sẻ link. Bỏ trống thì dùng
# DEFAULT_SITE_URL trong src/config/site.ts. Có tên miền riêng thì khai báo ở đây và trên Vercel
VITE_SITE_URL=

# Link app di động trên App Store / Google Play cho banner mời tải app (chỉ hiện trên điện thoại).
# Bỏ trống thì banner không hiện trên nền tảng đó. Khi app phát hành thì khai báo trên Vercel
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
