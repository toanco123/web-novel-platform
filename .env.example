# Copy file này thành .env rồi sửa giá trị (.env không được commit)

# Dev server: đổi cổng/host tùy ý, vd PORT=4000
HOST=localhost
PORT=3000

# Supabase: lấy từ Supabase Dashboard > Project Settings > API.
# Bỏ trống thì web chạy bằng dữ liệu giả trong localStorage (api.mock.ts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true: dùng dữ liệu giả dù đã điền Supabase ở trên (làm UI offline). Test tự động luôn bật
VITE_USE_MOCK=

# Nút đăng nhập mạng xã hội đã bật trên Supabase (cần Client ID/Secret), vd: google,facebook
VITE_AUTH_PROVIDERS=
