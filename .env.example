# Copy file này thành .env rồi sửa giá trị (.env không được commit)

# Dev server: đổi cổng/host tùy ý, vd PORT=4000
HOST=localhost
PORT=3000

# Supabase: lấy từ Supabase Dashboard > Project Settings > API.
# Bỏ trống thì web chạy bằng dữ liệu giả trong localStorage (api.mock.ts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true: dùng dữ liệu giả dù đã điền Supabase ở trên (làm UI offline). Test tự động luôn bật
VITE_USE_MOCK=

# Nút đăng nhập mạng xã hội đã bật trên Supabase (cần Client ID/Secret), vd: google,facebook
VITE_AUTH_PROVIDERS=

# Captcha Cloudflare Turnstile cho đăng nhập/đăng ký/quên mật khẩu (Site Key của widget). Bỏ trống thì
# không có captcha. Khai báo ở đây và trên Vercel TRƯỚC, deploy xong mới bật Captcha ở Supabase
# Dashboard (Authentication > Attack Protection, dán Secret Key), nếu không form sẽ bị Supabase từ chối.
VITE_TURNSTILE_SITE_KEY=

# Địa chỉ web dùng cho canonical, sitemap và ảnh xem trước khi chia sẻ link. Bỏ trống thì dùng
# DEFAULT_SITE_URL trong src/config/site.ts. Có tên miền riêng thì khai báo ở đây và trên Vercel
VITE_SITE_URL=

# Link app di động trên App Store / Google Play cho banner mời tải app (chỉ hiện trên điện thoại).
# Bỏ trống thì banner không hiện trên nền tảng đó. Khi app phát hành thì khai báo trên Vercel
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Theo dõi lỗi bằng Sentry (documents/plan-theo-doi-loi.md): DSN lấy ở Sentry > Project Settings >
# Client Keys, không phải bí mật. Bỏ trống thì không gửi lỗi; dev và bản dữ liệu giả không bao giờ gửi.
# Tải source map lúc build cần thêm SENTRY_AUTH_TOKEN (bí mật): chỉ khai báo trên Vercel, không ghi ở đây.
VITE_SENTRY_DSN=

# Giọng AI cho nghe truyện (documents/plan-giong-ai.md). Các biến dưới đây là BÍ MẬT của hàm Vercel
# api/tts: chỉ khai báo trên Vercel (Settings > Environment Variables), không ghi giá trị ở đây.
#   SUPABASE_SERVICE_ROLE_KEY   Supabase Dashboard > Project Settings > API Keys (secret / service_role)
#   GOOGLE_TTS_API_KEY          Google Cloud > APIs & Services > Credentials, giới hạn chỉ Text-to-Speech API
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET   Cloudflare R2 > Manage API tokens
#   TTS_PUBLIC_BASE_URL         tên miền công khai của bucket R2, vd https://audio.example.com
#   TTS_MONTH_CHAR_CAP          mức chặn ký tự / tháng của cả web (mặc định 900000)
#   TTS_USER_DAY_CHAR_CAP       mức chặn ký tự / người / ngày (mặc định 30000)
# Chạy `npm run dev` mà muốn thử Giọng AI: chuyển /api/tts sang một bản đã deploy, vd
# TTS_DEV_PROXY=https://web-novel-platform-gules.vercel.app
TTS_DEV_PROXY=
